# TMDB (https://www.themoviedb.org/settings/api) — boş bırakılırsa koddaki varsayılan anahtarlar kullanılır
VITE_TMDB_API_KEY=
VITE_TMDB_ACCESS_TOKEN=

# Supabase (https://supabase.com/dashboard/project/_/settings/api) — boş bırakılırsa üyelik özellikleri kapanır
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
