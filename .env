# TMDB (https://www.themoviedb.org/settings/api) — boş bırakılırsa koddaki varsayılan anahtarlar kullanılır
VITE_TMDB_API_KEY=
VITE_TMDB_ACCESS_TOKEN=

# Sitenin kalıcı adresi: canonical etiketleri, Open Graph, site haritası ve robots.txt bunu kullanır.
# Vercel'de boş bırakılırsa projenin üretim alan adı (VERCEL_PROJECT_PRODUCTION_URL) kullanılır.
VITE_SITE_URL=

# İsteğe bağlı: cihazlar arası senkronizasyon (Upstash Redis).
# Vercel'de Marketplace > Upstash for Redis eklendiğinde bu değişkenler otomatik tanımlanır.
# DİKKAT: VITE_ ön eki KULLANMAYIN — bu anahtarlar yalnızca sunucuda (api/) okunur, tarayıcıya gönderilmez.
# Tanımlanmazsa geliştirmede bellek içi depo kullanılır, üretimde senkronizasyon kapalı kalır.
KV_REST_API_URL=
KV_REST_API_TOKEN=
